{
  "name": "socketmap",
  "version": "0.10.0",
  "description": "Zero-dependency, self-contained network trace visualizer and sequence diagram generator",
  "type": "module",
  "bin": {
    "socketmap": "./bin/traceviz.mjs",
    "traceviz": "./bin/traceviz.mjs"
  },
  "scripts": {
    "test": "node --test",
    "generate:examples": "node scripts/generate-examples.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "demo": "node scripts/demo-report.mjs",
    "generate:theme": "node scripts/generate-theme.mjs",
    "verify": "npm test && node scripts/generate-theme.mjs --check",
    "check:policy-links": "node scripts/check-policy-links.mjs"
  },
  "keywords": [
    "netlog",
    "har",
    "trace",
    "sequence-diagram",
    "network-visualization",
    "svg",
    "zero-dependency"
  ],
  "author": "JR Generations",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
